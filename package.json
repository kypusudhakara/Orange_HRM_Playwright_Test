{
  "name": "orangehrm-employee-lifecycle",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript employee lifecycle assessment for OrangeHRM",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
